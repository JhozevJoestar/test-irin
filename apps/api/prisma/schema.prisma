generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  CLIENT
}
model Company {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  branches Branch[]
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role Role
  companyId String?
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([companyId])
}
model Branch {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name String
  address String
  createdAt DateTime @default(now())
  metrics DailyMetric[]
  reviews Review[]
  @@index([companyId])
}
model DailyMetric {
  id String @id @default(cuid())
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  views Int
  websiteClicks Int
  calls Int
  routes Int
  createdAt DateTime @default(now())
  @@unique([branchId, date])
  @@index([date])
}
model Review {
  id String @id @default(cuid())
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rating Int
  text String
  status String @default("PUBLISHED")
  createdAt DateTime @default(now())
  @@index([branchId, createdAt])
}
